                        <div class="p-2.5 rounded-lg bg-blue-50 dark:bg-blue-900/20 text-blue-800 dark:text-blue-300">
                            <span class="font-semibold block">To'g'ri javob:</span>
                            ${escapeHtml(correctAnsText)}
