        /* ==========================================================================
           5. TEST ENGINE (TAKRORLANMAS ALGORITM)
           ========================================================================== */
        function startTest(mode, categoryKey = null) {
            currentMode = mode;
            currentCategory = categoryKey;
            currentQuestionIndex = 0;
            userAnswers = [];
            currentStreak = 0;
            totalTimeSpent = 0;

            // Filter by Category if needed
            let filteredPool = [...questionPool];
            if (mode === 'category' && categoryKey) {
                filteredPool = questionPool.filter(q => q.category === categoryKey);
                if (filteredPool.length === 0) {
                    showToast("Ushbu mavzuda savollar topilmadi!", "error");
                    return;
                }
            }

            // Shuffle questions to ensure unique unrepeated order
            let shuffledQuestions = shuffleArray(filteredPool);

            // Determine test length
            let limit = shuffledQuestions.length;
            if (mode === 'quick') limit = Math.min(10, shuffledQuestions.length);
            else if (mode === 'standard') limit = Math.min(20, shuffledQuestions.length);

            currentActiveQuestions = shuffledQuestions.slice(0, limit);

            // Prepare questions (Shuffle Options dynamically for NO-REPEAT position bias)
            currentActiveQuestions = currentActiveQuestions.map(q => {
                const prepared = prepareShuffledQuestion(q);
                return prepared;
            });

            // UI Adjustments
            document.getElementById('total-q-num').innerText = currentActiveQuestions.length;

            if (mode === 'infinite') {
                document.getElementById('streak-counter').classList.remove('hidden');
                document.getElementById('streak-counter').classList.add('flex');
            } else {
                document.getElementById('streak-counter').classList.add('hidden');
                document.getElementById('streak-counter').classList.remove('flex');
            }

            // Setup Timer
            setupTimer(mode, currentActiveQuestions.length);

            // Render First Question
            showScreen('test-screen');
            renderCurrentQuestion();
        }

        function prepareShuffledQuestion(q) {
            // Create options array with original correct tracking
            const rawOptions = q.options.map((optText, idx) => ({
                text: optText,
                isCorrect: idx === q.correctIndex
            }));

            // Shuffle option positions
            const shuffledOpt = shuffleArray(rawOptions);
            const newCorrectIdx = shuffledOpt.findIndex(o => o.isCorrect);

            return {
                ...q,
                shuffledOptions: shuffledOpt.map(o => o.text),
                correctIndex: newCorrectIdx
            };
        }

        function setupTimer(mode, questionCount) {
            if (testTimerInterval) clearInterval(testTimerInterval);

            // Standard: 45 sec per question
            timeRemaining = questionCount * 45;
            updateTimerDisplay();

            testTimerInterval = setInterval(() => {
                timeRemaining--;
                totalTimeSpent++;
                updateTimerDisplay();

                if (timeRemaining <= 0) {
                    clearInterval(testTimerInterval);
                    showToast("Vaqt tugadi!", "warning");
                    finishTest();
                }
            }, 1000);
        }

        function updateTimerDisplay() {
            const mins = Math.floor(timeRemaining / 60);
            const secs = timeRemaining % 60;
            document.getElementById('timer-display').innerText = 
                `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
        }

        function renderCurrentQuestion() {
            const q = currentActiveQuestions[currentQuestionIndex];

            // Category badge
            const catInfo = CATEGORIES_INFO[q.category] || { name: "Umumiy" };
            document.getElementById('category-badge').innerText = catInfo.name;

            // Progress bar
            document.getElementById('current-q-num').innerText = currentQuestionIndex + 1;
            const progress = ((currentQuestionIndex + 1) / currentActiveQuestions.length) * 100;
            document.getElementById('progress-bar').style.width = `${progress}%`;

            // Question Text
            document.getElementById('question-text').innerText = q.question;

            // Code block if available
            const codeContainer = document.getElementById('code-container');
            if (q.code) {
                document.getElementById('code-block').innerText = q.code;
                codeContainer.classList.remove('hidden');
            } else {
                codeContainer.classList.add('hidden');
            }

            // Reset Explanation box
            document.getElementById('explanation-box').classList.add('hidden');

            // Render Options
            const container = document.getElementById('options-container');
            container.innerHTML = '';

            const optionLetters = ['A', 'B', 'C', 'D'];

            q.shuffledOptions.forEach((optText, idx) => {
                const btn = document.createElement('button');
                btn.className = `option-btn w-full text-left p-4 rounded-xl border border-slate-200 dark:border-slate-800 hover:border-blue-500/60 dark:hover:border-blue-500/60 bg-white/50 dark:bg-slate-900/50 hover:bg-blue-50/50 dark:hover:bg-blue-900/20 transition flex items-start space-x-3 group`;
                btn.onclick = () => selectOption(idx);

                btn.innerHTML = `
                    <span class="w-7 h-7 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-bold text-xs flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white transition flex-shrink-0">
                        ${optionLetters[idx]}
                    </span>
                    <span class="text-sm font-medium pt-0.5 text-slate-800 dark:text-slate-200 leading-snug">${escapeHtml(optText)}</span>
                `;
                container.appendChild(btn);
            });

            // Reset Next Button
            const nextBtn = document.getElementById('next-btn');
            nextBtn.disabled = true;
            nextBtn.querySelector('span').innerText = (currentQuestionIndex === currentActiveQuestions.length - 1) ? "Yakunlash" : "Keyingisi";
        }

        function selectOption(index) {
            const q = currentActiveQuestions[currentQuestionIndex];
            const isCorrect = index === q.correctIndex;

            // Record Answer
            userAnswers[currentQuestionIndex] = {
                questionId: q.id,
                selectedIndex: index,
                isCorrect: isCorrect
            };

            // Option styling feedback
            const container = document.getElementById('options-container');
            const btns = container.querySelectorAll('.option-btn');

            btns.forEach((btn, idx) => {
                btn.disabled = true;
                btn.classList.remove('hover:border-blue-500/60', 'hover:bg-blue-50/50');

                if (idx === q.correctIndex) {
                    btn.classList.add('border-emerald-500', 'bg-emerald-50/80', 'dark:bg-emerald-900/30', 'text-emerald-900', 'dark:text-emerald-200');
                    btn.querySelector('span').classList.add('bg-emerald-600', 'text-white');
                } else if (idx === index && !isCorrect) {
                    btn.classList.add('border-rose-500', 'bg-rose-50/80', 'dark:bg-rose-900/30', 'text-rose-900', 'dark:text-rose-200');
                    btn.querySelector('span').classList.add('bg-rose-600', 'text-white');
                }
            });

            // Audio & Streak
            if (isCorrect) {
                playSound('correct');
                currentStreak++;
            } else {
                playSound('wrong');
                currentStreak = 0;
            }

            document.getElementById('streak-val').innerText = currentStreak;

            // Show explanation
            if (q.explanation) {
                document.getElementById('explanation-text').innerText = q.explanation;
                document.getElementById('explanation-box').classList.remove('hidden');
            }

            // Enable Next
            document.getElementById('next-btn').disabled = false;
        }

        function skipQuestion() {
            playSound('click');
            userAnswers[currentQuestionIndex] = {
                questionId: currentActiveQuestions[currentQuestionIndex].id,
                selectedIndex: -1,
                isCorrect: false
            };
            nextQuestion();
        }

        function nextQuestion() {
            playSound('click');
            if (currentQuestionIndex < currentActiveQuestions.length - 1) {
                currentQuestionIndex++;
                renderCurrentQuestion();
            } else {
                finishTest();
            }
        }

        function confirmExitTest() {
            if (confirm("Testni to'xtatmoqchimisiz? Natijalar saqlanmaydi.")) {
                if (testTimerInterval) clearInterval(testTimerInterval);
                showScreen('home-screen');
            }
        }

        /* ==========================================================================
           6. TEST RESULTS & ANALYTICS
           ========================================================================== */
        function finishTest() {
            if (testTimerInterval) clearInterval(testTimerInterval);

            // Calculate stats
            let correctCount = 0;
            userAnswers.forEach(ans => {
                if (ans && ans.isCorrect) correctCount++;
            });

            const total = currentActiveQuestions.length;
            const percentage = Math.round((correctCount / total) * 100);

            // Update user stats
            userStats.completedTests = (userStats.completedTests || 0) + 1;
            if (percentage > (userStats.bestScore || 0)) {
                userStats.bestScore = percentage;
            }
            saveStats();

            // Populate Result Screen UI
            document.getElementById('res-correct').innerText = `${correctCount} / ${total}`;
            document.getElementById('res-wrong').innerText = total - correctCount;
            document.getElementById('res-percent').innerText = `${percentage}%`;

            const mins = Math.floor(totalTimeSpent / 60);
            const secs = totalTimeSpent % 60;
            document.getElementById('res-time').innerText = `${mins}:${secs.toString().padStart(2, '0')}`;

            // Grade Badge & Titles
            const titleEl = document.getElementById('result-title');
            const subEl = document.getElementById('result-subtitle');
            const iconContainer = document.getElementById('result-badge-icon');

            if (percentage >= 85) {
                titleEl.innerText = "A'lo Natija! 🏆";
                subEl.innerText = "Siz Informatika fanidan juda yuqori va mukammal bilimga egasiz.";
                iconContainer.className = "inline-flex items-center justify-center w-20 h-20 rounded-full bg-emerald-100 text-emerald-600 text-3xl font-extrabold mb-2";
                iconContainer.innerHTML = `<i class="fa-solid fa-trophy"></i>`;
            } else if (percentage >= 70) {
                titleEl.innerText = "Yaxshi Natija! 👍";
                subEl.innerText = "Bilimingiz yaxshi, biroq ayrim mavzular ustida yana ishlash tavsiya etiladi.";
                iconContainer.className = "inline-flex items-center justify-center w-20 h-20 rounded-full bg-blue-100 text-blue-600 text-3xl font-extrabold mb-2";
                iconContainer.innerHTML = `<i class="fa-solid fa-thumbs-up"></i>`;
            } else if (percentage >= 50) {
                titleEl.innerText = "Qoniqarli 😐";
                subEl.innerText = "Natijangiz o'rtacha. Yana ham yaxshiroq tayyorgarlik ko'rish zarur.";
                iconContainer.className = "inline-flex items-center justify-center w-20 h-20 rounded-full bg-amber-100 text-amber-600 text-3xl font-extrabold mb-2";
                iconContainer.innerHTML = `<i class="fa-solid fa-face-meh"></i>`;
            } else {
                titleEl.innerText = "Qayta Urinib Ko'ring 😕";
                subEl.innerText = "Afsuski, natijangiz past. Mavzularni qaytadan o'rganib chiqishni maslahat beramiz.";
                iconContainer.className = "inline-flex items-center justify-center w-20 h-20 rounded-full bg-rose-100 text-rose-600 text-3xl font-extrabold mb-2";
                iconContainer.innerHTML = `<i class="fa-solid fa-book-open"></i>`;
            }

            // Render Detailed Question Review
            renderReviewList();

            showScreen('result-screen');
        }

