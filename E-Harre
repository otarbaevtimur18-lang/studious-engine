<!DOCTYPE html>
<html lang="uz" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>InfoTest Pro - Informatika Fanidan Intellektual Test Platformasi</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0f7ff',
                            100: '#e0effe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            800: '#1e40af',
                            900: '#1e3a8a',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            transition: background-color 0.3s, color 0.3s;
        }

        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(0,0,0,0.05);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(100,116,139,0.3);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(100,116,139,0.5);
        }

        .glass-panel {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }

        .dark .glass-panel {
            background: rgba(30, 41, 59, 0.85);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .animated-pulse {
            animation: pulse-border 2s infinite;
        }

        @keyframes pulse-border {
            0% { box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.4); }
            70% { box-shadow: 0 0 0 10px rgba(59, 130, 246, 0); }
            100% { box-shadow: 0 0 0 0 rgba(59, 130, 246, 0); }
        }

        /* Print styles for downloading/printing reports */
        @media print {
            body { background: white !important; color: black !important; }
            .no-print { display: none !important; }
            .print-only { display: block !important; }
            .glass-panel { border: none !important; shadow: none !important; background: transparent !important; }
        }
    </style>
</head>
<body class="bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-100 min-h-full flex flex-col selection:bg-blue-500 selection:text-white">

    <!-- Top Navigation Header -->
    <header class="sticky top-0 z-40 w-full border-b border-slate-200 dark:border-slate-800 glass-panel no-print">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <!-- Logo -->
            <div class="flex items-center space-x-3 cursor-pointer" onclick="showScreen('home-screen')">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-500 flex items-center justify-center text-white shadow-lg shadow-blue-500/30">
                    <i class="fa-solid fa-laptop-code text-xl"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold tracking-tight bg-gradient-to-r from-blue-600 to-indigo-600 dark:from-blue-400 dark:to-indigo-400 bg-clip-text text-transparent">InfoTest Pro</h1>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Informatika Fanidan Interaktiv Test</p>
                </div>
            </div>

            <!-- Header Controls -->
            <div class="flex items-center space-x-2 sm:space-x-4">
                <button id="sound-toggle" onclick="toggleSound()" class="p-2.5 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-200/60 dark:hover:bg-slate-800 transition" title="Ovoz efeti">
                    <i id="sound-icon" class="fa-solid fa-volume-high text-lg"></i>
                </button>
                <button id="theme-toggle" onclick="toggleTheme()" class="p-2.5 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-200/60 dark:hover:bg-slate-800 transition" title="Tungi/Kunduzgi rejim">
                    <i id="theme-icon" class="fa-solid fa-moon text-lg"></i>
                </button>
                <button onclick="showScreen('add-question-screen')" class="hidden sm:flex items-center space-x-2 bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 hover:bg-blue-100 dark:hover:bg-blue-900/50 px-3.5 py-2 rounded-lg font-medium text-sm transition">
                    <i class="fa-solid fa-plus-circle"></i>
                    <span>Savol qo'shish</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

        <!-- 1. HOME SCREEN / DASHBOARD -->
        <section id="home-screen" class="space-y-8">
            <!-- Hero Banner -->
            <div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 p-6 sm:p-10 text-white shadow-xl">
                <div class="absolute -right-10 -bottom-10 opacity-10 text-9xl font-extrabold select-none pointer-events-none">
                    <i class="fa-solid fa-microchip"></i>
                </div>
                <div class="relative z-10 max-w-2xl">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-white/20 text-white backdrop-blur-md mb-4">
                        <i class="fa-solid fa-shield-halved mr-1.5"></i> Takrorlanmas Savollar Tizimi
                    </span>
                    <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-3">Informatika fanidan bilimlaringizni sinang!</h2>
                    <p class="text-blue-100 text-sm sm:text-base leading-relaxed mb-6">
                        Milliy sertifikat, OTM imtihonlari va umumiy maktab va kollej dasturi bo'yicha tayyorlangan interaktiv testlar. Har safar unikal va yangilangan savollar!
                    </p>
                    <div class="flex flex-wrap gap-3">
                        <button onclick="startTest('quick')" class="bg-white text-blue-600 font-semibold px-6 py-3 rounded-xl shadow-lg hover:bg-blue-50 transition transform active:scale-95 flex items-center space-x-2">
                            <i class="fa-solid fa-bolt text-amber-500"></i>
                            <span>Tezkor Test (10)</span>
                        </button>
                        <button onclick="startTest('standard')" class="bg-blue-700/60 hover:bg-blue-700/80 text-white font-semibold px-6 py-3 rounded-xl border border-white/20 backdrop-blur-md transition transform active:scale-95 flex items-center space-x-2">
                            <i class="fa-solid fa-list-check"></i>
                            <span>Standart Test (20)</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Stats Bar -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                <div class="glass-panel p-4 rounded-xl flex items-center space-x-4 shadow-sm">
                    <div class="w-12 h-12 rounded-lg bg-blue-100 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-database"></i>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Jami Savollar</p>
                        <p id="stat-total-q" class="text-xl font-bold">0</p>
                    </div>
                </div>
                <div class="glass-panel p-4 rounded-xl flex items-center space-x-4 shadow-sm">
                    <div class="w-12 h-12 rounded-lg bg-emerald-100 dark:bg-emerald-900/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Ishlangan Testlar</p>
                        <p id="stat-tests-completed" class="text-xl font-bold">0</p>
                    </div>
                </div>
                <div class="glass-panel p-4 rounded-xl flex items-center space-x-4 shadow-sm">
                    <div class="w-12 h-12 rounded-lg bg-amber-100 dark:bg-amber-900/40 text-amber-600 dark:text-amber-400 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-trophy"></i>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Eng Yuqori Natija</p>
                        <p id="stat-best-score" class="text-xl font-bold">0%</p>
                    </div>
                </div>
                <div class="glass-panel p-4 rounded-xl flex items-center space-x-4 shadow-sm">
                    <div class="w-12 h-12 rounded-lg bg-purple-100 dark:bg-purple-900/40 text-purple-600 dark:text-purple-400 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-folder-tree"></i>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Mavzular Soni</p>
                        <p id="stat-categories-count" class="text-xl font-bold">6</p>
                    </div>
                </div>
            </div>

            <!-- Test Modes Selection -->
            <div>
                <h3 class="text-lg font-bold mb-4 flex items-center text-slate-800 dark:text-slate-200">
                    <i class="fa-solid fa-gamepad mr-2 text-blue-500"></i> Test Rejimini Tanlang
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                    <!-- Tezkor -->
                    <div onclick="startTest('quick')" class="glass-panel p-5 rounded-xl border hover:border-blue-500/50 hover:shadow-lg transition cursor-pointer group flex flex-col justify-between">
                        <div>
                            <div class="w-10 h-10 rounded-lg bg-amber-500/10 text-amber-500 flex items-center justify-center text-lg mb-3 group-hover:scale-110 transition">
                                <i class="fa-solid fa-bolt"></i>
                            </div>
                            <h4 class="font-bold text-base mb-1">Tezkor Test</h4>
                            <p class="text-xs text-slate-500 dark:text-slate-400">10 ta tasodifiy savol. Bilimingizni tezda sinab olish uchun eng maqbul usul.</p>
                        </div>
                        <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 flex justify-between items-center text-xs font-semibold text-blue-600 dark:text-blue-400">
                            <span>10 Savol</span>
                            <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition"></i>
                        </div>
                    </div>

                    <!-- Standart -->
                    <div onclick="startTest('standard')" class="glass-panel p-5 rounded-xl border hover:border-blue-500/50 hover:shadow-lg transition cursor-pointer group flex flex-col justify-between">
                        <div>
                            <div class="w-10 h-10 rounded-lg bg-blue-500/10 text-blue-500 flex items-center justify-center text-lg mb-3 group-hover:scale-110 transition">
                                <i class="fa-solid fa-graduation-cap"></i>
                            </div>
                            <h4 class="font-bold text-base mb-1">Standart Test</h4>
                            <p class="text-xs text-slate-500 dark:text-slate-400">20 ta har xil mavzulardagi aralash savollar va taymer bilan imtihon rejimi.</p>
                        </div>
                        <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 flex justify-between items-center text-xs font-semibold text-blue-600 dark:text-blue-400">
                            <span>20 Savol</span>
                            <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition"></i>
                        </div>
                    </div>

                    <!-- Cheksiz -->
                    <div onclick="startTest('infinite')" class="glass-panel p-5 rounded-xl border hover:border-blue-500/50 hover:shadow-lg transition cursor-pointer group flex flex-col justify-between">
                        <div>
                            <div class="w-10 h-10 rounded-lg bg-purple-500/10 text-purple-500 flex items-center justify-center text-lg mb-3 group-hover:scale-110 transition">
                                <i class="fa-solid fa-infinity"></i>
                            </div>
                            <h4 class="font-bold text-base mb-1">Cheksiz Mashq</h4>
                            <p class="text-xs text-slate-500 dark:text-slate-400">Savollar tugaguncha takrorlanmasdan kelib veradi. Rekord o'rnatish imkoniyati!</p>
                        </div>
                        <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 flex justify-between items-center text-xs font-semibold text-purple-600 dark:text-purple-400">
                            <span>Cheksiz</span>
                            <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition"></i>
                        </div>
                    </div>

                    <!-- Qo'shish Mobile Link -->
                    <div onclick="showScreen('add-question-screen')" class="glass-panel p-5 rounded-xl border hover:border-blue-500/50 hover:shadow-lg transition cursor-pointer group flex flex-col justify-between sm:hidden">
                        <div>
                            <div class="w-10 h-10 rounded-lg bg-emerald-500/10 text-emerald-500 flex items-center justify-center text-lg mb-3 group-hover:scale-110 transition">
                                <i class="fa-solid fa-plus"></i>
                            </div>
                            <h4 class="font-bold text-base mb-1">Savol Qo'shish</h4>
                            <p class="text-xs text-slate-500 dark:text-slate-400">Bazaga o'zingizning yangi savollaringizni kiriting va do'stlaringiz bilan ulashing.</p>
                        </div>
                        <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 flex justify-between items-center text-xs font-semibold text-emerald-600 dark:text-emerald-400">
                            <span>Yangi Savol</span>
                            <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Categories Section -->
            <div>
                <h3 class="text-lg font-bold mb-4 flex items-center text-slate-800 dark:text-slate-200">
                    <i class="fa-solid fa-layer-group mr-2 text-indigo-500"></i> Mavzuli Testlar
                </h3>
                <div id="categories-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                    <!-- Categories will be rendered dynamically -->
                </div>
            </div>
        </section>

        <!-- 2. TEST TAKING SCREEN -->
        <section id="test-screen" class="hidden max-w-3xl mx-auto space-y-6">
            <!-- Header bar for test -->
            <div class="glass-panel p-4 rounded-xl flex items-center justify-between shadow-sm">
                <button onclick="confirmExitTest()" class="text-slate-500 hover:text-slate-700 dark:hover:text-slate-200 px-3 py-1.5 rounded-lg text-sm transition">
                    <i class="fa-solid fa-xmark mr-1"></i> Chiqish
                </button>

                <!-- Streak / Info -->
                <div class="flex items-center space-x-4">
                    <div id="streak-counter" class="hidden items-center space-x-1 text-amber-500 font-bold text-sm bg-amber-500/10 px-3 py-1 rounded-full">
                        <i class="fa-solid fa-fire"></i>
                        <span id="streak-val">0</span>
                    </div>

                    <!-- Timer -->
                    <div id="timer-box" class="flex items-center space-x-2 bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 px-3 py-1.5 rounded-lg font-mono font-bold text-sm">
                        <i class="fa-regular fa-clock"></i>
                        <span id="timer-display">15:00</span>
                    </div>
                </div>
            </div>

            <!-- Progress Bar -->
            <div class="space-y-1.5">
                <div class="flex justify-between text-xs font-semibold text-slate-500">
                    <span>Savol: <span id="current-q-num">1</span> / <span id="total-q-num">10</span></span>
                    <span id="category-badge" class="bg-indigo-100 dark:bg-indigo-900/40 text-indigo-600 dark:text-indigo-400 px-2 py-0.5 rounded">Mavzu</span>
                </div>
                <div class="w-full bg-slate-200 dark:bg-slate-800 rounded-full h-2.5 overflow-hidden">
                    <div id="progress-bar" class="bg-blue-600 h-2.5 rounded-full transition-all duration-300" style="width: 10%"></div>
                </div>
            </div>

            <!-- Main Question Card -->
            <div class="glass-panel p-6 sm:p-8 rounded-2xl shadow-md border space-y-6 relative">
                <!-- Question Text -->
                <div>
                    <h3 id="question-text" class="text-lg sm:text-xl font-bold leading-snug text-slate-900 dark:text-slate-100">
                        Savol yuklanmoqda...
                    </h3>
                </div>

                <!-- Code block container (if present in question) -->
                <div id="code-container" class="hidden">
                    <pre class="bg-slate-900 text-slate-100 p-4 rounded-xl text-sm font-mono overflow-x-auto"><code id="code-block"></code></pre>
                </div>

                <!-- Options List -->
                <div id="options-container" class="space-y-3">
                    <!-- Dynamic Options -->
                </div>

                <!-- Explanation Box (Hidden initially) -->
                <div id="explanation-box" class="hidden p-4 rounded-xl bg-blue-50 dark:bg-blue-900/30 border border-blue-200 dark:border-blue-800/50 text-sm space-y-1">
                    <div class="font-bold text-blue-700 dark:text-blue-300 flex items-center">
                        <i class="fa-solid fa-lightbulb mr-2 text-amber-500"></i> Izoh & Tushuntirish:
                    </div>
                    <p id="explanation-text" class="text-slate-600 dark:text-slate-300 leading-relaxed"></p>
                </div>

                <!-- Action Footer -->
                <div class="flex justify-between items-center pt-4 border-t border-slate-100 dark:border-slate-800">
                    <button id="skip-btn" onclick="skipQuestion()" class="px-4 py-2 text-sm text-slate-500 hover:text-slate-700 dark:hover:text-slate-300 font-medium transition">
                        O'tkazib yuborish
                    </button>

                    <button id="next-btn" onclick="nextQuestion()" disabled class="bg-blue-600 hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed text-white font-semibold px-6 py-2.5 rounded-xl shadow transition flex items-center space-x-2">
                        <span>Keyingisi</span>
                        <i class="fa-solid fa-arrow-right text-xs"></i>
                    </button>
                </div>
            </div>
        </section>

        <!-- 3. RESULTS SCREEN -->
        <section id="result-screen" class="hidden max-w-4xl mx-auto space-y-8">
            <!-- Grade Card Header -->
            <div id="result-header-card" class="glass-panel p-8 rounded-2xl shadow-xl text-center space-y-4 border relative overflow-hidden">
                <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-blue-100 dark:bg-blue-900/50 text-blue-600 dark:text-blue-400 text-3xl font-extrabold mb-2" id="result-badge-icon">
                    <i class="fa-solid fa-award"></i>
                </div>

                <div>
                    <h2 id="result-title" class="text-2xl sm:text-3xl font-black">A'lo Natija!</h2>
                    <p id="result-subtitle" class="text-sm text-slate-500 dark:text-slate-400 mt-1">Siz Informatika bo'yicha juda yuqori bilimga egasiz.</p>
                </div>

                <!-- Score Stats breakdown -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-xl mx-auto pt-4">
                    <div class="p-3 bg-slate-100 dark:bg-slate-800/60 rounded-xl">
                        <span class="block text-xs text-slate-500">To'g'ri javoblar</span>
                        <span id="res-correct" class="text-xl font-bold text-emerald-600 dark:text-emerald-400">0</span>
                    </div>
                    <div class="p-3 bg-slate-100 dark:bg-slate-800/60 rounded-xl">
                        <span class="block text-xs text-slate-500">Noto'g'ri javoblar</span>
                        <span id="res-wrong" class="text-xl font-bold text-rose-600 dark:text-rose-400">0</span>
                    </div>
                    <div class="p-3 bg-slate-100 dark:bg-slate-800/60 rounded-xl">
                        <span class="block text-xs text-slate-500">Foiz darajasi</span>
                        <span id="res-percent" class="text-xl font-bold text-blue-600 dark:text-blue-400">0%</span>
                    </div>
                    <div class="p-3 bg-slate-100 dark:bg-slate-800/60 rounded-xl">
                        <span class="block text-xs text-slate-500">Sarf qilingan vaqt</span>
                        <span id="res-time" class="text-xl font-bold text-purple-600 dark:text-purple-400">00:00</span>
                    </div>
                </div>

                <div class="flex flex-wrap justify-center gap-3 pt-4 no-print">
                    <button onclick="startTest(currentMode, currentCategory)" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-xl font-semibold text-sm shadow transition flex items-center space-x-2">
                        <i class="fa-solid fa-rotate-right"></i>
                        <span>Qayta Urinib Ko'rish</span>
                    </button>
                    <button onclick="window.print()" class="bg-slate-200 dark:bg-slate-800 hover:bg-slate-300 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 px-5 py-2.5 rounded-xl font-semibold text-sm transition flex items-center space-x-2">
                        <i class="fa-solid fa-print"></i>
                        <span>Chop etish / Yuklash</span>
                    </button>
                    <button onclick="showScreen('home-screen')" class="bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 text-slate-600 dark:text-slate-300 px-5 py-2.5 rounded-xl font-semibold text-sm transition">
                        Bosh sahifa
                    </button>
                </div>
            </div>

            <!-- Detailed Question Review List -->
            <div class="space-y-4">
                <h3 class="text-lg font-bold flex items-center">
                    <i class="fa-solid fa-magnifying-glass mr-2 text-blue-500"></i> Savollar Tahlili va Xatolar ustida ishlash
                </h3>
                <div id="review-list-container" class="space-y-4">
                    <!-- Dynamic review items generated here -->
                </div>
            </div>
        </section>

        <!-- 4. ADD CUSTOM QUESTION SCREEN -->
        <section id="add-question-screen" class="hidden max-w-2xl mx-auto space-y-6">
            <div class="flex items-center justify-between">
                <h2 class="text-2xl font-bold flex items-center">
                    <i class="fa-solid fa-square-plus mr-2.5 text-blue-600"></i> Yangi Savol Qo'shish
                </h2>
                <button onclick="showScreen('home-screen')" class="text-slate-500 hover:text-slate-700 dark:hover:text-slate-300 text-sm">
                    <i class="fa-solid fa-arrow-left mr-1"></i> Orqaga
                </button>
            </div>

            <form id="add-question-form" onsubmit="handleSaveQuestion(event)" class="glass-panel p-6 sm:p-8 rounded-2xl shadow-md border space-y-5">
                <!-- Category Select -->
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2">Mavzu / Bo'lim</label>
                    <select id="new-q-category" required class="w-full bg-slate-100 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="hardware">Kompyuter qurilmalari va Dasturiy ta'minot</option>
                        <option value="binary">Sanoq sistemalari va Axborot nazariyasi</option>
                        <option value="programming">Dasturlash asoslari (Python, Algoritmlar)</option>
                        <option value="networks">Kompyuter tarmoqlari va Internet</option>
                        <option value="security">Kiberxavfsizlik va Axborot xavfsizligi</option>
                        <option value="office">Microsoft Office va OS</option>
                    </select>
                </div>

                <!-- Question Text -->
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2">Savol Matni</label>
