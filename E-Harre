        /* ==========================================================================
           7. CUSTOM QUESTION BUILDER
           ========================================================================== */
        function handleSaveQuestion(e) {
            e.preventDefault();

            const category = document.getElementById('new-q-category').value;
            const questionText = document.getElementById('new-q-text').value.trim();
            const codeText = document.getElementById('new-q-code').value.trim();
            const explanationText = document.getElementById('new-q-explanation').value.trim();

            const opt0 = document.getElementById('opt-0').value.trim();
            const opt1 = document.getElementById('opt-1').value.trim();
            const opt2 = document.getElementById('opt-2').value.trim();
            const opt3 = document.getElementById('opt-3').value.trim();

            const radios = document.getElementsByName('correct_opt');
            let correctIdx = -1;
            for (let r of radios) {
                if (r.checked) {
                    correctIdx = parseInt(r.value);
                    break;
                }
            }

            if (correctIdx === -1) {
                showToast("Iltimos, to'g'ri javob variantini belgilang!", "warning");
                return;
            }

            const newQ = {
                id: 'custom-' + Date.now(),
                category: category,
                question: questionText,
                code: codeText || null,
                options: [opt0, opt1, opt2, opt3],
                correctIndex: correctIdx,
                explanation: explanationText
            };

            // Save to LocalStorage
            let customStored = [];
            const existing = localStorage.getItem('infotest_custom_q');
            if (existing) {
                try { customStored = JSON.parse(existing); } catch(e){}
            }
            customStored.push(newQ);
            localStorage.setItem('infotest_custom_q', JSON.stringify(customStored));

            // Reload pool
            questionPool.push(newQ);

            // Clear Form
            document.getElementById('add-question-form').reset();

            showToast("Yangi savol muvaffaqiyatli saqlandi!", "success");
            updateDashboardStats();
            renderCategoryGrid();
            showScreen('home-screen');
        }

